# InsightX Environment Variables
# Copy this file to .env and fill in your actual API keys

# -- Vanna AI Vector Store --
# If provided, InsightX will use Pinecone (Production). Otherwise, it falls back to local ChromaDB.
PINECONE_API_KEY=

# Groq API Key (used by app/main.py and scripts/train_vanna.py)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Names
GROQ_MODEL=openai/gpt-oss-120b
